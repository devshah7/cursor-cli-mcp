{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": ["@typescript-eslint", "prettier"],
  "extends": ["plugin:@typescript-eslint/recommended", "plugin:prettier/recommended"],
  "rules": {
    "no-console": "error",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-floating-promises": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "prettier/prettier": "error",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Property[key.name='shell'][value.type='Literal'][value.value=true]",
        "message": "Shell injection guard: never use spawn/exec with shell: true"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/tools/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/adapters/**"],
                "message": "tools/ must not import from adapters/ — use ports/ only (see ARCHITECTURE.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/adapters/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/tools/**"],
                "message": "Adapters must not import from tools (upward dependency violation)"
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/"]
}
